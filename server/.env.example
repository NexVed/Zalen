# Copy to server/.env

APP_ENV=development
PORT=8080

# Clerk issuer domain (same value used by convex/auth.config.ts)
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Comma-separated list of allowed browser origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Convex deployment the MCP tools read and write. The deploy key stays on this server.
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_DEPLOY_KEY=

# URL agents use to reach this API. Defaults to http://127.0.0.1:$PORT
PUBLIC_API_URL=http://127.0.0.1:8080
WEB_URL=http://localhost:3000
