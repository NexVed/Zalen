    "@stylexjs/stylex": "^0.19.1",
    "convex": "^1.47.0",
    "lucide-react": "^1.59.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@stylexjs/babel-plugin": "^0.19.1",
