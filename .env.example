# ---------------------------------------------------------------------------
# Frontend (Next.js) — copy to .env.local and fill in
# ---------------------------------------------------------------------------

# Clerk — https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk JWT issuer domain, used by Convex to validate Clerk tokens.
# Find it under Clerk Dashboard → JWT Templates → "convex" → Issuer.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Clerk redirect paths (optional, defaults shown)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Convex deployment URL — printed by `bunx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Go Fiber API base URL (used by the frontend to call the service layer)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Maps - choose ONE provider for the hackathon
# ---------------------------------------------------------------------------
# Recommended free option: Geoapify (3,000 credits/day, no credit card)
# Create a project and copy its API key: https://myprojects.geoapify.com/
# One key covers map tiles, place search, businesses, and routing.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Google Maps: free Demo Key for hackathons (no billing details needed).
# Get it: https://developers.google.com/maps/demo-key
# Supports maps, Places (New), and Compute Routes within demo quotas.
# Standard production keys require a billing-enabled Google Cloud project.
# Enable Maps JavaScript API, Places API (New), and Routes API.
# Browser key: restrict to localhost, 127.0.0.1, and your deployed domain.
# Create a key: https://console.cloud.google.com/google/maps-apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a JavaScript vector map ID for a cloud-styled Google map.
# A map ID is a map configuration identifier, not an API key.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
